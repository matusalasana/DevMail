# Copy to server/.env and adjust. Never commit the real .env file.

# PostgreSQL connection string (required). Uses the Neon serverless driver,
# so it must point at a Neon database.
DATABASE_URL=postgresql://user:password@your-neon-host/devmail?sslmode=require

# development | test | production. In production, internal error details are hidden from API responses.
NODE_ENV=development

# REST API
API_HOST=0.0.0.0
API_PORT=3000

# SMTP capture server
SMTP_HOST=0.0.0.0
SMTP_PORT=1025
